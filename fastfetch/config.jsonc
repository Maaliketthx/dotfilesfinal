{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "small",
    "source": "arch",
    "color": {
      "1": "white",
      "2": "white"
    },
    "width": 16,
    "padding": {
      "right": 3
    }
  },

  "display": {
    "separator": "  ",
    "key": {
      "color": "white"
    },
    "color": {
      "title": "white",
      "keys": "white"
    }
  },

  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}"
    },

    {
      "type": "custom",
      "format": "────────────────────"
    },

    {
      "type": "os",
      "key": "  OS"
    },
    {
      "type": "kernel",
      "key": "  Kernel"
    },
    {
      "type": "wm",
      "key": "  WM"
    },
    {
      "type": "shell",
      "key": "  Shell"
    },
    {
      "type": "terminal",
      "key": "  Terminal"
    },

    "break",

    {
      "type": "cpu",
      "key": "󰻠  CPU"
    },
    {
      "type": "gpu",
      "key": "󰍛  GPU"
    },
    {
      "type": "memory",
      "key": "󰘚  RAM"
    }
  ]
}
